  "private": true,
  "description": "SELENA — a survivor-centered platform for anonymous stories and privacy-safe aggregate patterns. V1 (frontend-only, synthetic data).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
