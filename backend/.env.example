# Development example only. Never commit real secrets.
DJANGO_SETTINGS_MODULE=selena_api.settings.development
DJANGO_SECRET_KEY=replace-in-real-environments
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
DJANGO_MAX_REQUEST_BYTES=262144

POSTGRES_DB=selena
POSTGRES_USER=selena
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=0

# Shared cache used by production throttles/session-adjacent controls.
REDIS_URL=redis://127.0.0.1:6379/0

# Keep 0 unless deployment has a known trusted reverse-proxy count.
DRF_NUM_PROXIES=0
SUBMISSION_THROTTLE_RATE=5/hour

# Provisional Phase 0 retention baseline; owner approval is still tracked.
PENDING_SUBMISSION_RETENTION_DAYS=90
STATISTICS_ONLY_RETENTION_DAYS=730
DELETION_TOMBSTONE_RETENTION_DAYS=1095

# Production security controls
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
