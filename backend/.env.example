# Development example only. Never commit real secrets.
DJANGO_SETTINGS_MODULE=selena_api.settings.development
DJANGO_SECRET_KEY=replace-in-real-environments
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
DJANGO_MAX_REQUEST_BYTES=262144

POSTGRES_DB=selena
POSTGRES_USER=selena
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=0

# Production security controls
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
